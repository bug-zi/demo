# 复制成 .env.local 才会生效（.gitignore 已忽略 *.local）
# 不填也能玩 —— 会自动走本地引擎，台词来自 src/data/personas.js

# 真实 AI 的 key。注意：Vite 会把它打进前端产物，只适合本地演示。
VITE_LLM_API_KEY=

# 可选：模型
VITE_LLM_MODEL=claude-opus-5

# 可选：走代理时填，比如 http://localhost:8787
VITE_LLM_BASE_URL=

# 可选：adaptive（更聪明但更慢）或 disabled（默认，对局要快）
VITE_LLM_THINKING=disabled
